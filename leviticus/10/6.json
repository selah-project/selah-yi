{"tier":"glm-5.2","verse":6,"ref":"leviticus 10:6","book":"leviticus","lang":"yi","chapter":10,"translation":"און משה האָט געזאָגט צו אהרן און צו אלעזר און צו איתמר זײַנע זין: אײַערע קעפּ זאָלט איר נישט אויפֿלייזן און אײַערע מאַנטלעך זאָלט איר נישט צוריסן, און איר זאָלט נישט שטאַרבן, און אויף דער גאַנצער עדה וועט ער צאָרן; און אײַערע ברידער, די גאַנצע בית־ישׂראל, זאָלן באַוײַנען ⟨את⟩ די פֿאַרברענענע, וואָס יהוה האָט פֿאַרברענט.","tokens":[{"surface":"ויאמר","gloss":"און האָט געזאָגט"},{"surface":"משה","gloss":"משה"},{"surface":"אל","gloss":"צו"},{"surface":"אהרן","gloss":"אהרן"},{"surface":"ולאלעזר","gloss":"און צו אלעזר"},{"surface":"ולאיתמר","gloss":"און צו איתמר"},{"surface":"בניו","gloss":"זײַנע זין"},{"surface":"ראשיכם","gloss":"אײַערע קעפּ"},{"surface":"אל","gloss":"נישט"},{"surface":"תפרעו","gloss":"זאָלט איר אויפֿלייזן"},{"surface":"ובגדיכם","gloss":"און אײַערע מאַנטלעך"},{"surface":"לא","gloss":"נישט"},{"surface":"תפרמו","gloss":"זאָלט איר צוריסן"},{"surface":"ולא","gloss":"און נישט"},{"surface":"תמתו","gloss":"זאָלט שטאַרבן"},{"surface":"ועל","gloss":"און אויף"},{"surface":"כל","gloss":"דער גאַנצער"},{"surface":"העדה","gloss":"עדה"},{"surface":"יקצף","gloss":"וועט ער צאָרן"},{"surface":"ואחיכם","gloss":"און אײַערע ברידער"},{"surface":"כל","gloss":"די גאַנצע"},{"surface":"בית","gloss":"בית"},{"surface":"ישראל","gloss":"ישׂראל"},{"surface":"יבכו","gloss":"זאָלן באַוײַנען"},{"surface":"את","gloss":"⟨את⟩","marks":"די פֿאַרברענענע"},{"surface":"השרפה","gloss":"די פֿאַרברענענע"},{"surface":"אשר","gloss":"וואָס"},{"surface":"שרף","gloss":"האָט פֿאַרברענט"},{"surface":"יהוה","gloss":"יהוה"}],"timestamp":"2026-09-10T20:00:27.609236939Z","model":"glm-5.3"}